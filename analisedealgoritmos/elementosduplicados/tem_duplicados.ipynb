      "source": [
        "def tem_duplicados(lista):\n",
        "    for i in range(len(lista)-1):\n",
        "        for j in range(i+1,len(lista)):\n",
        "            if (lista[i]==lista[j]):\n",
        "                return True\n",
        "    return False\n",
        "\n",
        "\n",
        "\n",
        "lista='Café'\n",
        "\n",
        "\n",
        "print(tem_duplicados(lista))"
      ]
    }
  ]
