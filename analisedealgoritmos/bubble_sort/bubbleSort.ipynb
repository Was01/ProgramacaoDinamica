      "source": [
        "\n",
        "def bubbleSort(lista):\n",
        "  n=len(lista)\n",
        "  for j in range(n-1):\n",
        "    for i in range(n-1):\n",
        "      if lista[i]>lista[i+1]:\n",
        "        lista[i],lista[i+1]=lista[i+1],lista[i]\n",
        "  return lista"
      ]
    },
    {
      "cell_type": "code",
      "source": [
        "minha_lista=[3,-1,-80,45,7]\n",
        "bubbleSort(minha_lista)"
