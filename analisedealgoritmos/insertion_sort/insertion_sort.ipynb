      "source": [
        "def insertion_sort(lista):\n",
        "  n=len(lista)\n",
        "  for i in range(1,n):\n",
        "    chave=lista[i]\n",
        "    j=i-1\n",
        "    while (j>=0 and lista[j]>chave):\n",
        "      lista[j+1]=lista[j]\n",
        "      j=j-1\n",
        "    lista[j+1]=chave\n",
        "  return lista\n"
      ]
    },
